<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Copyright Saab AB, 2026 (https://github.com/SafirSDK/minilog)
  This file is part of minilog, released under the MIT License.

  Makes UTF-8 the process's active code page (Windows 10 1903 and later), so
  that a non-ASCII word on the command line reaches main() as the UTF-8 bytes
  minilog expects instead of the system's legacy code page. CMake hands this
  file to the linker, which merges it with its own default manifest.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
