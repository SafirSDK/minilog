; minilog-cli-viewer configuration file
;
; This file configures the display and filtering options for minilog-cli-viewer.py.
; The viewer reads minilog.conf to find the log files, so only display
; preferences and filters belong here. The two files have different owners:
; minilog.conf is a deployment fact installed with the system, this one is one
; person's taste, and two users of the same machine can reasonably differ.
;
; Where this file is looked for, in order:
;   1. ./minilog-cli-viewer.conf          (the current directory)
;   2. beside whichever minilog.conf was found
;
; Where minilog.conf is looked for, in order:
;   1. ./minilog.conf                     (the current directory)
;   2. %ProgramData%\minilog\minilog.conf  (Windows — where the installer puts it)
;      /etc/minilog/minilog.conf          (Linux)
;   3. beside minilog-cli-viewer.py
;
; The current directory comes first in both lists on purpose: a Windows
; shortcut's "Start in" field, or a cd in a launcher script, then decides which
; configuration the viewer picks up, so several config directories can be kept
; and switched between.
;
; --config PATH and --viewer-config PATH name either file directly and skip the
; search. A path that is not there is an error rather than a fall-back to the
; search order, so a typo cannot quietly read the wrong logs. --verbose prints
; which files were found.
;
; If no viewer config file is found, the viewer uses sensible defaults.

; ─────────────────────────────────────────────────────────────────────────────
; Display settings
; ─────────────────────────────────────────────────────────────────────────────
[viewer]

; Columns to display (comma-separated, in order)
; Available columns: rcv, src, proto, facility, severity, hostname, app, pid, msgid, message
; Default: rcv, facility, severity, hostname, app, pid, message
columns = rcv, facility, severity, hostname, app, pid, message

; Timestamp format (applies when 'rcv' column is shown)
; Options:
;   iso   - Full ISO8601 format: 2026-03-29T14:30:22Z
;   short - Short format:        03-29 14:30:22
;   time  - Time only:           14:30:22
; Default: short
timestamp_format = short

; Use colored output (facility/severity color-coding)
; Colors are automatically disabled when output is not a TTY
; Default: true
use_colors = true

; ─────────────────────────────────────────────────────────────────────────────
; Filtering
; ─────────────────────────────────────────────────────────────────────────────
[filters]

; Exclude messages containing any of these strings (one per line)
; Matching is case-insensitive and searches the entire message field
; Default: none
exclude =
    nodecom
    Turning logging

; Include only messages matching ANY of these patterns (one per line)
; If empty or not specified, all messages pass (except excluded ones)
; Matching is case-insensitive
; Default: none (include all)
include =
