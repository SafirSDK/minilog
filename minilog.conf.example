; minilog configuration file
; All available options are listed here with their defaults.
; Restart minilog to apply any changes.
;
; Every key below is one minilog knows. A key it does not recognise is a config
; error naming the section and the key, so a typo cannot silently leave a
; setting at its default.

; ─────────────────────────────────────────────────────────────────────────────
; Server settings
; ─────────────────────────────────────────────────────────────────────────────
[server]

; IP address to bind the UDP socket to.
; 0.0.0.0 listens on all interfaces; use 127.0.0.1 to restrict to localhost.
host = 0.0.0.0

; UDP port to listen on (0–65535).
; 0 lets the OS assign an ephemeral port (useful for testing).
; Note: binding to port 514 may require elevated privileges on Linux.
udp_port = 514

; Number of I/O worker threads, 1 to 256. One thread per physical CPU core is a
; reasonable upper bound; the default of 4 is suitable for most deployments.
; The cap exists because a misplaced digit used to be a crash rather than a
; config error — minilog spawns a thread per worker.
workers = 4

; How much received-but-not-yet-written log to hold in memory before further
; datagrams are dropped. A sender faster than the disk would otherwise grow
; minilog until the OS kills it, and UDP gives the sender no way to know either
; way, so the excess is dropped deliberately and the count is reported to the
; system log. Same units as max_size; a plain number is bytes. Resident memory
; is a few times this figure, since a queued message is held once per output
; section it routes to. There is no "unlimited" setting.
max_queue_bytes = 16MB

; ─────────────────────────────────────────────────────────────────────────────
; Output sections  [output.<name>]
;
; Define one or more named output sections. At least one of text_file or
; jsonl_file must be specified in each section. Multiple [output.*] sections
; may be defined; messages are routed to every section whose facility filter
; matches.
;
; text_file and jsonl_file must be ABSOLUTE paths. A relative path would mean
; something different to each program that reads this file — minilog itself, the
; cli-viewer and the web-viewer all have their own working directory, and a
; Windows service inherits C:\Windows\System32 — so it is a config error.
; Environment variables are not expanded: %ProgramData%\minilog\logs is not a
; path. On Windows, use a drive (C:\ProgramData\minilog\logs\syslog.log) or a
; UNC share (\\server\share\logs\syslog.log).
; ─────────────────────────────────────────────────────────────────────────────
[output.main]

; Raw text log: each line is the verbatim UDP payload followed by a newline.
; No decoding or reformatting is applied.
text_file = /var/log/minilog/syslog.log

; JSONL log: one UTF-8 JSON object per line with parsed fields.
; Fields: rcv, src, proto, facility, severity, hostname, app, pid, msgid, message
jsonl_file = /var/log/minilog/syslog.jsonl

; Rotate both files when either exceeds this size.
; Supported units: B, KB, MB, GB. Set to 0 to disable rotation.
; Rotated filenames: syslog.1.log, syslog.2.log, ...
max_size = 100MB

; Number of rotated files to keep per output section. 0 = keep all.
max_files = 10

; Comma-separated list of syslog facility names to accept, or * for all.
; Standard names: kern, user, mail, daemon, auth, syslog, lpr, news, uucp,
;                 clock, authpriv, ftp, ntp, audit, alert, local0–local7
; Aliases: kernel=kern, security=auth, system=daemon, cron=clock,
;          logaudit=audit, logalert=alert
facility = *

; Set to false to silently discard messages that could not be parsed
; (proto = UNKNOWN). Useful to suppress binary noise on UDP port 514.
include_malformed = true


; ─── Example: a second output section filtering to auth/authpriv only ────────
;[output.auth]
;text_file  = /var/log/minilog/auth.log
;jsonl_file = /var/log/minilog/auth.jsonl
;max_size   = 50MB
;max_files  = 5
;facility   = auth,authpriv
;include_malformed = false

; ─────────────────────────────────────────────────────────────────────────────
; Web viewer  [web_viewer]
;
; Where minilog-web-viewer listens. It is a deployment fact — a port somebody
; has to open in a firewall — so it lives here with the rest of them, not in a
; command-line flag. Changing it takes effect on the next restart of the viewer
; (Windows: `sc stop minilog-web-viewer` then `sc start minilog-web-viewer`).
;
; Note for Windows: the installer's Start Menu and desktop shortcuts are built
; from the port in this file at install time. Nothing can keep them in step with
; an edit made afterwards, so update them by hand or re-run the installer.
; ─────────────────────────────────────────────────────────────────────────────
[web_viewer]

; Address to bind the HTTP listener to. Leave empty for every interface, on both
; IPv4 and IPv6; 127.0.0.1 restricts the viewer to the local machine. The viewer
; has no authentication, so anyone who can reach this address can read every log
; it exposes.
host =

; TCP port to listen on.
port = 9514

; ─────────────────────────────────────────────────────────────────────────────
; UDP forwarding
; ─────────────────────────────────────────────────────────────────────────────
[forwarding]

; Set to true to forward received messages to another syslog endpoint.
enabled = false

; Destination hostname or IP address (IPv4 or IPv6). A name is resolved once,
; when minilog starts, and the address found is used for the lifetime of the
; process — so a collector that moves needs a restart.
;
; A name that does not resolve at startup is not a startup failure: minilog runs
; with forwarding off, reports it once, and retries in the background until it
; succeeds. That is deliberate, because a Windows service set to start
; automatically is routinely running before DNS is.
;
; The port goes in the 'port' key below. A value such as '10.0.0.5:514' or
; 'syslog.example.com:514' is a config error rather than a name that would never
; resolve.
host = 10.0.0.5

; Destination UDP port.
port = 514

; Facilities to forward. Same syntax as output.facility above.
facility = *

; Messages longer than this many bytes are truncated before forwarding.
; The string "... [TRUNCATED: N bytes]" is appended to the shortened message.
; Set to 0 for no limit.
max_message_size = 2048
